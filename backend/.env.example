# 端口设置
PORT=3001
NODE_ENV=development

# PostgreSQL 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=english_ai
DB_USER=postgres
DB_PASSWORD=postgres

# JWT 配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# AI 配置
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4

# 前端地址
FRONTEND_URL=http://localhost:5173

# 日志级别
LOG_LEVEL=debug
